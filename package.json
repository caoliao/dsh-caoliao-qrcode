{
  "name": "dsh-caoliao-qrcode",
  "version": "2026.11.1",
  "private": true,
  "description": "用对话轻松建码、管理表单、分析巡检记录，让日常工作更简单。",
  "icon": "./logo.png",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./logo.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "oauth.js",
    "callback-page.js",
    "client.js",
    "client.css",
    "logo.png",
    "cordis.patch.yml",
    "skills",
    "skill-manifest.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "BRANDING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": "0.2.2-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-mcp-manager": "0.2.2-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.2",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "undici": "6.29.1"
  },
  "scripts": {
    "build": "python scripts/build.py && python scripts/sync-root.py",
    "test": "python scripts/build.py && python scripts/sync-root.py --check && node --test tests/test-oauth.mjs",
    "npm:prepare": "python scripts/build.py && python scripts/prepare-npm.py",
    "prepublishOnly": "node -e \"throw new Error('Publish only the verified dist/npm package')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caoliao/dsh-caoliao-qrcode.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "yaml": "2.8.3",
    "undici": "6.29.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
