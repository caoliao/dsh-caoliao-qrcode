{
  "name": "dsh-caoliao-qrcode",
  "version": "2026.1118.0",
  "private": true,
  "description": "用对话轻松建码、管理表单、分析巡检记录，让日常工作更简单。",
  "icon": "./logo.png",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./logo.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "oauth.js",
    "callback-page.js",
    "client.js",
    "client.css",
    "logo.png",
    "cordis.patch.yml",
    "skills",
    "skill-manifest.json",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "BRANDING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-skill": "*",
    "@deepseek-ai/dsh-mcp-manager": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "react": "^18.2.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "undici": "6.29.1"
  },
  "scripts": {
    "prepublishOnly": "node -e \"throw new Error('Local preview only; publication is not authorized')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caoliao/dsh-caoliao-qrcode.git"
  },
  "license": "MIT"
}
